rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function reportOf(reportId) {
      return firestore.get(/databases/(default)/documents/reports/$(reportId)).data;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function hasCallerEmail(data) {
      return isAuthenticated()
        && request.auth.token.email is string
        && data.sharedWithEmails is list
        && callerEmail() in data.sharedWithEmails;
    }

    // Collaboration: owner, direct invitee, owned folder, invited folder,
    // or public link. Production fix B13: folder-collaborator readers were
    // denied image reads via SDK while seeing the report itself.
    function canReadReport(data) {
      return isAuthenticated() && (
        data.ownerUid == request.auth.uid
        || hasCallerEmail(data)
        || data.isShared == true
        || (data.folderId is string
          && (folderOf(data).ownerUid == request.auth.uid || hasCallerEmail(folderOf(data))))
      );
    }

    function folderOf(data) {
      return firestore.get(/databases/(default)/documents/folders/$(data.folderId)).data;
    }

    function canWriteReport(data) {
      return isAuthenticated() && (
        data.ownerUid == request.auth.uid
        || hasCallerEmail(data)
        || (data.folderId is string
          && (folderOf(data).ownerUid == request.auth.uid || hasCallerEmail(folderOf(data))))
      );
    }

    // Phase 1.3 (B5): was `allow read, write: if isAuthenticated()` —
    // any signed-in user could read/overwrite ANY report's images.
    // Collaborators may upload (edit); reads additionally allow
    // explicitly shared (public-link) reports.
    match /reports/{reportId}/images/{fileName} {
      allow read: if canReadReport(reportOf(reportId));
      allow write: if canWriteReport(reportOf(reportId));
    }
  }
}
