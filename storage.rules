rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function reportOf(reportId) {
      return firestore.get(/databases/(default)/documents/reports/$(reportId)).data;
    }

    // Phase 1.3 (B5): was `allow read, write: if isAuthenticated()` —
    // any signed-in user could read/overwrite ANY report's images.
    // Writes require owning the parent report; reads additionally allow
    // explicitly shared (public-link) reports. Matches the Firestore
    // `reports/{id}/images` subcollection rule.
    match /reports/{reportId}/images/{fileName} {
      allow read: if isAuthenticated() && (
        reportOf(reportId).ownerUid == request.auth.uid
        || reportOf(reportId).isShared == true
      );
      allow write: if isAuthenticated()
        && reportOf(reportId).ownerUid == request.auth.uid;
    }
  }
}
