rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function owns(data) {
      return isAuthenticated() && data.ownerUid == request.auth.uid;
    }

    // Entities that historically used snake_case owner_id (projects,
    // dashboards) — accept either field during the Phase-6 schema
    // unification. Both must equal the caller when present.
    function ownsFlexible(data) {
      return isAuthenticated() && (
        data.ownerUid == request.auth.uid || data.owner_id == request.auth.uid
      );
    }

    function ownsReport(reportId) {
      return isAuthenticated() && reportId is string
        && get(/databases/$(database)/documents/reports/$(reportId)).data.ownerUid == request.auth.uid;
    }

    // Tables / report_issues / evidences carry a parent report_id
    // (with legacy camelCase reportId fallback).
    function parentReportId(data) {
      return data.report_id is string ? data.report_id
        : (data.reportId is string ? data.reportId : '');
    }

    function ownsParentReport(data) {
      return ownsReport(parentReportId(data));
    }

    function ownsIssue(issueId) {
      return isAuthenticated() && issueId is string
        && get(/databases/$(database)/documents/issues/$(issueId)).data.ownerUid == request.auth.uid;
    }

    function ownsDashboard(dashboardId) {
      return isAuthenticated() && dashboardId is string
        && ownsFlexible(get(/databases/$(database)/documents/dashboards/$(dashboardId)).data);
    }

    function dashboardRefOf(data) {
      return data.dashboard_id is string ? data.dashboard_id
        : (data.dashboardId is string ? data.dashboardId : '');
    }

    function ownsWidget(data) {
      return ownsDashboard(dashboardRefOf(data));
    }

    // Insights always carry dashboard_id/dashboardId at runtime (see
    // getInsights/saveInsight); created_by is the fallback owner signal.
    function ownsInsight(data) {
      return isAuthenticated() && (
        ownsDashboard(dashboardRefOf(data))
        || (data.created_by is string && data.created_by == request.auth.uid)
      );
    }

    // Reports collection & subcollections
    match /reports/{reportId} {
      // Anonymous reads are strictly limited to fetching a specific report explicitly made public (get).
      // Phase 1.2 (B24): list is per-document owner-checked, so a
      // collection scan only ever returns the caller's own reports —
      // no cross-user enumeration.
      allow get: if owns(resource.data) || resource.data.isShared == true;
      allow list: if owns(resource.data);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if owns(resource.data);

      match /images/{imageId} {
        allow read: if ownsReport(reportId)
          || get(/databases/$(database)/documents/reports/$(reportId)).data.isShared == true;
        allow write: if ownsReport(reportId);
      }
    }

    // Folders collection for hierarchical report organization
    // Phase 1.2 (B4): was `allow read, write: if isAuthenticated()` —
    // any user could read/rewrite anyone's folders.
    match /folders/{folderId} {
      allow get, list: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);
    }

    // API Keys collection for AI agents and integrations
    // Phase 1.2 (B4): scoped to the key owner. keyHash is never used for
    // ownership here; lookup-by-hash happens server-side only.
    match /api_keys/{keyId} {
      allow get, list: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);
    }

    // Counters collection for atomic report numbering
    // Phase 2.1 (B7): each user owns exactly one counter document,
    // `counters/reports_{uid}`, advanced inside a transaction by
    // allocateReportNumber(). The legacy global `counters/reports` is
    // no longer written by clients (kept readable for diagnostics).
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && counterId == 'reports_' + request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Issues collection & comments subcollection
    // Phase 1.2 (B4): scoped to the issue owner (was any-authenticated).
    match /issues/{issueId} {
      allow get, list: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);

      match /comments/{commentId} {
        allow read: if ownsIssue(issueId);
        allow write: if ownsIssue(issueId);
      }
    }

    // Whitelist collection for authorized users
    match /authorized_users/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email.matches('.*@example[.]com'));
    }

    // User-specific settings (AI config, severity ordering, etc.)
    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Projects collection
    // Phase 1.2 (B4): scoped via owner_id/ownerUid (was any-authenticated).
    match /projects/{projectId} {
      allow get, list: if ownsFlexible(resource.data);
      allow create: if ownsFlexible(request.resource.data);
      allow update, delete: if ownsFlexible(resource.data);
    }

    // Report-Issue join collection
    // Phase 1.2 (B4): scoped via the parent report (was any-authenticated).
    match /report_issues/{linkId} {
      allow get, list: if ownsParentReport(resource.data);
      allow create: if ownsParentReport(request.resource.data);
      allow update, delete: if ownsParentReport(resource.data);
    }

    // Evidences collection
    // Phase 1.2 (B4): scoped via the parent report (was any-authenticated).
    match /evidences/{evidenceId} {
      allow get, list: if ownsParentReport(resource.data);
      allow create: if ownsParentReport(request.resource.data);
      allow update, delete: if ownsParentReport(resource.data);
    }

    // Structured tables collection
    match /tables/{tableId} {
      // Public sharing may fetch a table by its known id only; listing remains private.
      // Phase 1.2 (B24): list now requires owning the parent report
      // (was any-authenticated get/list).
      allow get: if ownsParentReport(resource.data)
        || get(/databases/$(database)/documents/reports/$(parentReportId(resource.data))).data.isShared == true;
      allow list: if ownsParentReport(resource.data);
      allow create: if ownsParentReport(request.resource.data);
      allow update, delete: if ownsParentReport(resource.data);
    }

    // Dashboards & Widgets collection
    // Phase 1.2 (B4): dashboards scoped to owner; widgets/insights scoped
    // via their parent dashboard (were any-authenticated).
    match /dashboards/{dashboardId} {
      allow get, list: if ownsFlexible(resource.data);
      allow create: if ownsFlexible(request.resource.data);
      allow update, delete: if ownsFlexible(resource.data);
    }

    match /widgets/{widgetId} {
      allow get, list: if ownsWidget(resource.data);
      allow create: if ownsWidget(request.resource.data);
      allow update, delete: if ownsWidget(resource.data);
    }

    // Insights collection
    match /insights/{insightId} {
      allow get, list: if ownsInsight(resource.data);
      allow create: if ownsInsight(request.resource.data);
      allow update, delete: if ownsInsight(resource.data);
    }

    // Audit events collection (append-only for actors)
    // Phase 1.2 (B24): reads scoped to the actor; creates must be
    // self-attributed (were any-authenticated read/create).
    match /audit_events/{eventId} {
      allow read: if isAuthenticated() && resource.data.actor_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false; // Immutable audit log!
    }
  }
}
