rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    function owns(data) {
      return isAuthenticated() && data.ownerUid == request.auth.uid;
    }

    // Collaboration (invites by email). Sharing key = lowercase account
    // email (no users directory; matched against the verified token email).
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function hasCallerEmail(data) {
      return isAuthenticated()
        && request.auth.token.email is string
        && data.sharedWithEmails is list
        && callerEmail() in data.sharedWithEmails;
    }

    function isFolderCollaborator(folderId) {
      return isAuthenticated() && folderId is string && folderId.size() > 0
        && hasCallerEmail(get(/databases/$(database)/documents/folders/$(folderId)).data);
    }

    function isFolderOwner(folderId) {
      return isAuthenticated() && folderId is string && folderId.size() > 0
        && get(/databases/$(database)/documents/folders/$(folderId)).data.ownerUid == request.auth.uid;
    }

    // Report read: owner, direct invitee, public link, or via folder
    // (owned folder, or invited folder — current AND future reports).
    function canReadReport(data) {
      return owns(data)
        || hasCallerEmail(data)
        || data.isShared == true
        || (data.folderId is string && (isFolderOwner(data.folderId) || isFolderCollaborator(data.folderId)));
    }

    // Report write: owner has full rights; collaborators may edit content
    // but NEVER ownership/sharing/placement/numbering/lifecycle fields
    // (archive/restore/publish stay owner-only).
    function collaboratorSafeReportUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['ownerUid', 'sharedWithEmails', 'isShared', 'shareToken', 'sharedAt', 'folderId', 'reportNumber', 'status', 'statusBeforeArchive', 'archived_at', 'archivedAt']
      );
    }

    function canWriteReport(data) {
      return owns(data)
        || (hasCallerEmail(data) && collaboratorSafeReportUpdate())
        || ((data.folderId is string && isFolderCollaborator(data.folderId)) && collaboratorSafeReportUpdate());
    }

    // Issue's parent report id (either link field).
    function issueReportId(data) {
      return data.linkedReportId is string ? data.linkedReportId
        : (data.reportId is string ? data.reportId : '');
    }

    function reportDataOf(reportId) {
      return get(/databases/$(database)/documents/reports/$(reportId)).data;
    }

    function canReadIssue(data) {
      return owns(data)
        || (issueReportId(data) != '' && canReadReport(reportDataOf(issueReportId(data))));
    }

    function collaboratorSafeIssueUpdate() {
      // Archive lifecycle stays owner/report-owner-only: collaborators may
      // edit content but NEVER ownership/linkage/archival fields.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['ownerUid', 'linkedReportId', 'reportId', 'archived_at', 'archivedAt']
      );
    }

    // Archive/restore/delete stay OWNER-ONLY, except the report owner may
    // archive/restore issues linked to THEIR report (cascade when a report
    // is archived). Only archival timestamps + updatedAt may change on that
    // path — never ownership/linkage/content.
    function isArchiveOnlyIssueChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(
        ['archived_at', 'archivedAt', 'updatedAt']
      );
    }

    function canArchiveIssue(data) {
      return isAuthenticated() && (
        data.ownerUid == request.auth.uid
        || (issueReportId(data) != '' && ownsReport(issueReportId(data)))
      );
    }

    function canWriteIssue(data) {
      return owns(data)
        || (issueReportId(data) != '' && (
          hasCallerEmail(reportDataOf(issueReportId(data)))
          || (reportDataOf(issueReportId(data)).folderId is string
            && isFolderCollaborator(reportDataOf(issueReportId(data)).folderId))
        ) && collaboratorSafeIssueUpdate());
    }

    // Entities that historically used snake_case owner_id (projects,
    // dashboards) — accept either field during the Phase-6 schema
    // unification. Both must equal the caller when present.
    function ownsFlexible(data) {
      return isAuthenticated() && (
        data.ownerUid == request.auth.uid || data.owner_id == request.auth.uid
      );
    }

    function ownsReport(reportId) {
      return isAuthenticated() && reportId is string
        && get(/databases/$(database)/documents/reports/$(reportId)).data.ownerUid == request.auth.uid;
    }

    // Tables / report_issues / evidences carry a parent report_id
    // (with legacy camelCase reportId fallback).
    function parentReportId(data) {
      return data.report_id is string ? data.report_id
        : (data.reportId is string ? data.reportId : '');
    }

    function ownsParentReport(data) {
      return ownsReport(parentReportId(data));
    }

    // Production fix B02: table creation requires WRITE access to the parent
    // report (owner, direct invitee, or folder collaborator). The old rule
    // allowed any READER (including anonymous public-link readers) to create
    // tables under a public report. Note: no collaboratorSafe* diff check on
    // create (resource doesn't exist yet) — parent linkage is enough.
    function canCreateTableFor(parentData) {
      return isAuthenticated() && (
        parentData.ownerUid == request.auth.uid
        || hasCallerEmail(parentData)
        || (parentData.folderId is string && isFolderCollaborator(parentData.folderId))
      );
    }

    function ownsIssue(issueId) {
      return isAuthenticated() && issueId is string
        && get(/databases/$(database)/documents/issues/$(issueId)).data.ownerUid == request.auth.uid;
    }

    function ownsDashboard(dashboardId) {
      return isAuthenticated() && dashboardId is string
        && ownsFlexible(get(/databases/$(database)/documents/dashboards/$(dashboardId)).data);
    }

    function dashboardRefOf(data) {
      return data.dashboard_id is string ? data.dashboard_id
        : (data.dashboardId is string ? data.dashboardId : '');
    }

    function ownsWidget(data) {
      return ownsDashboard(dashboardRefOf(data));
    }

    // Insights always carry dashboard_id/dashboardId at runtime (see
    // getInsights/saveInsight); created_by is the fallback owner signal.
    function ownsInsight(data) {
      return isAuthenticated() && (
        ownsDashboard(dashboardRefOf(data))
        || (data.created_by is string && data.created_by == request.auth.uid)
      );
    }

    // Reports collection & subcollections
    match /reports/{reportId} {
      // Anonymous reads are strictly limited to fetching a specific report explicitly made public (get).
      // Collaboration: list also returns invited + folder-visible reports
      // (per-document checks — no cross-user enumeration).
      allow get: if canReadReport(resource.data);
      allow list: if canReadReport(resource.data);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if owns(resource.data) || canWriteReport(resource.data);
      allow delete: if owns(resource.data);

      match /images/{imageId} {
        // Collaboration: readers read; editors (owner or collaborator)
        // may add/replace; deleting stays owner-only (like tables/issues).
        allow read: if canReadReport(get(/databases/$(database)/documents/reports/$(reportId)).data);
        allow create, update: if owns(get(/databases/$(database)/documents/reports/$(reportId)).data)
          || canWriteReport(get(/databases/$(database)/documents/reports/$(reportId)).data);
        allow delete: if owns(get(/databases/$(database)/documents/reports/$(reportId)).data);
      }
    }

    // Folders collection for hierarchical report organization
    // Collaboration: invited emails may READ the folder (needed to resolve
    // folder-level report access). All writes stay owner-only.
    match /folders/{folderId} {
      allow get, list: if ownsFlexible(resource.data) || hasCallerEmail(resource.data);
      allow create: if ownsFlexible(request.resource.data);
      allow update, delete: if ownsFlexible(resource.data);
    }

    // API Keys collection for AI agents and integrations
    // Phase 1.2 (B4): scoped to the key owner. keyHash is never used for
    // ownership here; lookup-by-hash happens server-side only.
    match /api_keys/{keyId} {
      allow get, list: if owns(resource.data);
      allow create: if owns(request.resource.data);
      allow update, delete: if owns(resource.data);
    }

    // Counters collection for atomic report numbering
    // Phase 2.1 (B7): each user owns exactly one counter document,
    // `counters/reports_{uid}`, advanced inside a transaction by
    // allocateReportNumber(). The legacy global `counters/reports` is
    // no longer written by clients (kept readable for diagnostics).
    match /counters/{counterId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
        && counterId == 'reports_' + request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    // Issues collection & comments subcollection
    // Collaboration: users with access to the LINKED report (B: only issues
    // linked to accessible reports are visible) may read/comment/edit, but
    // never reassign ownership/linkage/archival, and never delete (owner-only).
    // Archive/restore: issue owner OR the linked report's owner (cascade),
    // archival fields only.
    match /issues/{issueId} {
      allow get, list: if canReadIssue(resource.data);
      allow create: if owns(request.resource.data)
        || (issueReportId(request.resource.data) != ''
          && (hasCallerEmail(reportDataOf(issueReportId(request.resource.data)))
            || (reportDataOf(issueReportId(request.resource.data)).folderId is string
              && isFolderCollaborator(reportDataOf(issueReportId(request.resource.data)).folderId))));
      allow update: if owns(resource.data) || canWriteIssue(resource.data)
        || (canArchiveIssue(resource.data) && isArchiveOnlyIssueChange());
      allow delete: if owns(resource.data);

      match /comments/{commentId} {
        allow read: if canReadIssue(get(/databases/$(database)/documents/issues/$(issueId)).data);
        allow create: if canReadIssue(get(/databases/$(database)/documents/issues/$(issueId)).data);
        allow update, delete: if isAuthenticated()
          && resource.data.authorUid == request.auth.uid
          && canReadIssue(get(/databases/$(database)/documents/issues/$(issueId)).data);
      }
    }

    // Whitelist collection for authorized users
    match /authorized_users/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email.matches('.*@example[.]com'));
    }

    // User-specific settings (AI config, severity ordering, etc.)
    match /user_settings/{userId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.admin == true);
    }

    // Projects collection
    // Phase 1.2 (B4): scoped via owner_id/ownerUid (was any-authenticated).
    match /projects/{projectId} {
      allow get, list: if ownsFlexible(resource.data);
      allow create: if ownsFlexible(request.resource.data);
      allow update, delete: if ownsFlexible(resource.data);
    }

    // Report-Issue join collection
    // Phase 1.2 (B4): scoped via the parent report (was any-authenticated).
    match /report_issues/{linkId} {
      allow get, list: if ownsParentReport(resource.data);
      allow create: if ownsParentReport(request.resource.data);
      allow update, delete: if ownsParentReport(resource.data);
    }

    // Evidences collection
    // Phase 1.2 (B4): scoped via the parent report (was any-authenticated).
    match /evidences/{evidenceId} {
      allow get, list: if ownsParentReport(resource.data);
      allow create: if ownsParentReport(request.resource.data);
      allow update, delete: if ownsParentReport(resource.data);
    }

    // Structured tables collection
    // Collaboration: same report-level access as the parent report
    // (read + edit, never delete — owner-only).
    match /tables/{tableId} {
      // Public sharing may fetch a table by its known id only; listing remains private.
      allow get: if canReadReport(reportDataOf(parentReportId(resource.data)));
      allow list: if canReadReport(reportDataOf(parentReportId(resource.data)));
      allow create: if canCreateTableFor(reportDataOf(parentReportId(request.resource.data)));
      allow update: if ownsParentReport(resource.data)
        || canWriteReport(reportDataOf(parentReportId(resource.data)));
      allow delete: if ownsParentReport(resource.data);
    }

    // Dashboards & Widgets collection
    // Phase 1.2 (B4): dashboards scoped to owner; widgets/insights scoped
    // via their parent dashboard (were any-authenticated).
    match /dashboards/{dashboardId} {
      allow get, list: if ownsFlexible(resource.data);
      allow create: if ownsFlexible(request.resource.data);
      allow update, delete: if ownsFlexible(resource.data);
    }

    match /widgets/{widgetId} {
      allow get, list: if ownsWidget(resource.data);
      allow create: if ownsWidget(request.resource.data);
      allow update, delete: if ownsWidget(resource.data);
    }

    // Insights collection
    match /insights/{insightId} {
      allow get, list: if ownsInsight(resource.data);
      allow create: if ownsInsight(request.resource.data);
      allow update, delete: if ownsInsight(resource.data);
    }

    // Audit events collection (append-only for actors)
    // Phase 1.2 (B24): reads scoped to the actor; creates must be
    // self-attributed (were any-authenticated read/create).
    match /audit_events/{eventId} {
      allow read: if isAuthenticated() && resource.data.actor_id == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.actor_id == request.auth.uid;
      allow update, delete: if false; // Immutable audit log!
    }
  }
}
