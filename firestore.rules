rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Reports collection & subcollections
    match /reports/{reportId} {
      allow read, write: if isAuthenticated();

      match /images/{imageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Counters collection for atomic report numbering
    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Issues collection & comments subcollection
    match /issues/{issueId} {
      allow read, write: if isAuthenticated();

      match /comments/{commentId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Whitelist collection for authorized users
    match /authorized_users/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.token.admin == true || request.auth.token.email.matches('.*@example[.]com'));
    }
  }
}
